{
  "name": "eosc-fair-guide",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Page checks for the EOSC CZ FAIR Data Guide: rendering, accessibility, links and diagrams.",
  "license": "MIT",
  "scripts": {
    "browsers": "playwright install chromium",
    "check:page": "node tests/page/check_page.mjs",
    "check:discovery": "node tests/page/check_discovery.mjs",
    "check:helpers": "node tests/page/check_helpers.mjs",
    "check:model": "node tests/page/check_model.mjs",
    "check:assessment": "node tests/page/check_assess.mjs && node tests/page/check_questions.mjs && node tests/page/check_sources.mjs && node tests/page/check_languages.mjs && node tests/page/check_tests.mjs",
    "check:live": "node tests/page/check_live.mjs",
    "check:diagrams": "node tests/page/check_diagrams.mjs",
    "check:api": "node tests/api/check_api.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@axe-core/playwright": "4.13.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "ajv": "8.20.0",
    "mermaid": "11.16.1",
    "playwright": "1.63.0",
    "swagger-ui-dist": "5.33.0"
  }
}
