fip:FIP-Question-I1-D a owl:NamedIndividual, fip:FIP-Question;
  rdfs:label "FIP Question I1-D"@en;
  skos:definition "Which knowledge representation languages (allowing machine interoperation) do you use for datasets?"@en;
