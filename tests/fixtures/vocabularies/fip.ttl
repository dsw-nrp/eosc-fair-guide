fip:FIP-Question-F1-MD a owl:NamedIndividual, fip:FIP-Question;
  rdfs:label "FIP Question F1-MD"@en;
  skos:definition "What globally unique, persistent, resolvable identifiers do you use for metadata records?"@en;
