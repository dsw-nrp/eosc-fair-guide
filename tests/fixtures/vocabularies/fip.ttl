            <g transform=\"matrix(0.861513,-0,-0,1,6.455809,-36.988377)\">
                <path d=\"M78.545,386.96L84.391,389.883L78.545,392.806C80.007,391.344 80.007,388.421 78.545,386.96Z\" style=\"fill:rgb(104,104,104);\"/>
                <path d=\"M50.227,389.883L79.714,389.883\" style=\"fill:none;stroke:rgb(104,104,104);stroke-width:0.97px;stroke-linecap:butt;stroke-dasharray:0.974,0.974;\"/>
            </g>
