fip:FIP-Question-A1.2-MD a owl:NamedIndividual, fip:FIP-Question;
  rdfs:label "FIP Question A1.2-MD"@en;
  skos:definition "Which authentication & authorisation technique do you use for metadata records?"@en;
  fip:refers-to-principle fair:A1.2 .

fip:FIP-Question-A2 a owl:NamedIndividual, fip:FIP-Question;
