</svg>""" .

fip:FIP-Ontology_20260227 a owl:Ontology, gen:OntologyVersion;
  dct:isVersionOf fip:FIP-Ontology;
  rdfs:label "FIP Ontology version 20260227";
  gen:hasContentIndex <https://w3id.org/np/RAo6ciqn1-yxYXhsvA_iJBCHkypWFREtdhljG8gpofo8o> .

fip:Authentication-and-authorization-service a owl:Class, owl:Class;
  rdfs:label "Authentication and Authorization Service", "Authentication and authorization service"@en;
  rdfs:subClassOf fip:FAIR-Enabling-Resource, fip:FAIR-Supporting-Technology, fip:FAIR-Enabling-Resource,
    fip:FAIR-Supporting-Technology;
  skos:definition "A service that mediates access to digital objects according to specifed conditions.",
    "A service that mediates access to digital objects according to specifed conditions."@en;
  fip:enables fair:A1.2, fair:A1.2 .

fip:Available-FAIR-Supporting-Resource a owl:Class;
  rdfs:label "Available FAIR Supporting Resource"@en;
  rdfs:subClassOf fip:FAIR-Supporting-Resource;
  skos:definition "A FAIR Supporting Resource that is available for use."@en .

fip:Available-FAIR-Enabling-Resource a owl:Class;
  rdfs:label "Available FAIR-Enabling Resource"@en;
  rdfs:subClassOf fip:Available-FAIR-Supporting-Resource, fip:FAIR-Enabling-Resource;
  skos:definition "A FAIR-enabling resource that is available for use"@en .

fip:Communication-protocol a owl:Class, owl:Class;
  rdfs:label "Communication Protocol", "Communication protocol"@en;
  rdfs:subClassOf fip:FAIR-Enabling-Resource, fip:FAIR-Specification, fip:FAIR-Enabling-Resource,
    fip:FAIR-Specification;
  skos:definition "A specification of how messages are structured and exchanged.", "A specification of how messages are structured and exchanged."@en;
  fip:enables fair:A1.1, fair:A1.1 .

fip:Crosswalk a owl:Class;
  rdfs:label "Crosswalk"@en;
  rdfs:subClassOf fip:FAIR-Specification;
  skos:definition "A specification consisting of a set of rules that define how (meta)data elements or attributes from one schema can be aligned and mapped to (meta)data elements or attributes in another schema that share the same constraints and thus share the same semantic role."@en;
  fip:supports fair:I3 .

fip:Data-usage-license a owl:Class, owl:Class;
  rdfs:label "Data Usage License", "Data usage license"@en;
  rdfs:subClassOf fip:FAIR-Data-Policy, fip:FAIR-Enabling-Resource, fip:FAIR-Data-Policy,
    fip:FAIR-Enabling-Resource;
  skos:definition "A data policy that specifies legal restrictions on the reuse of the data.",
    "A data policy that specifies legal restrictions on the reuse of the data."@en;
  fip:enables fair:R1.1, fair:R1.1 .

fip:Digital-Object-Type a owl:Class;
  rdfs:label "Digital Object Type"@en;
  skos:definition "A digital object type is a classification of digital objects with respect to their informational functions to specify the nature of the digital object and the operations that can be performed on it."@en .

fip:Domain-Specific-Registry a owl:Class, owl:Class;
  rdfs:label "Domain-Specific Registry", "Domain-specific registry"@en;
  rdfs:subClassOf fip:Registry, fip:Registry;
  skos:definition "A registry designed to collect, provide access to, and enable searching of data within a particular domain or subject area",
    "A registry designed to collect, provide access to, and enable searching of data within a particular domain or subject area"@en .

fip:Editor a owl:Class;
  rdfs:label "Editor"@en;
  rdfs:subClassOf fip:FAIR-Supporting-Technology;
  skos:definition "A service that provides a user-friendly interface for easy editing of metadata, vocabularies or crosswalks."@en;
  fip:supports fair:F2, fair:I2, fair:I3 .

fip:Emerging-Community a owl:Class;
  rdfs:label "Emerging community"@en;
  rdfs:subClassOf fip:FAIR-Implementation-Community;
  skos:definition "An early-stage community committed to adopting and promoting FAIR principles for its data and services from the outset."@en .

fip:FAIR-Analysis-Service a owl:Class, owl:Class;
  dct:isPartOf fip:FIP-Ontology, fip:FIP-Ontology;
  rdfs:label "FAIR Analysis Service", "FAIR Analysis Service";
  rdfs:subClassOf fip:FAIR-Supporting-Resource, fip:FAIR-Supporting-Technology, fip:FAIR-Supporting-Resource,
    fip:FAIR-Supporting-Technology;
  skos:definition "An online resource that executes analytical workflows by natively consuming or generating FAIR Digital Objects.",
    "An online resource that executes analytical workflows by natively consuming or generating FAIR Digital Objects.";
  fip:supports fair:R1.3 .

fip:FAIR-Assessment-Specification a owl:Class, owl:Class;
  dct:isPartOf fip:FIP-Ontology, fip:FIP-Ontology;
  rdfs:label "FAIR Assessment Specification", "FAIR Assessment Specification";
  rdfs:subClassOf fip:FAIR-Specification, fip:FAIR-Supporting-Resource, fip:FAIR-Specification,
    fip:FAIR-Supporting-Resource;
  skos:definition "A specification defining metrics for each FAIR principle, benchmarks (as a collection of metrics), tests and scoring algorithm to assess the FAIRness of a digital object.",
    "A specification defining metrics for each FAIR principle, benchmarks (as a collection of metrics), tests and scoring algorithm to assess the FAIRness of a digital object.";
  fip:supports fair:R1.3 .

fip:FAIR-Case-Study a owl:Class;
  rdfs:label "FAIR case study"@en;
  rdfs:subClassOf fip:FAIR-Declaration;
  skos:definition "A description of a real-life situation where FAIR requirements of digital objects play a central role."@en .

fip:FAIR-Data-Policy a owl:Class;
  rdfs:label "FAIR Data Policy";
  rdfs:subClassOf fip:FAIR-Supporting-Resource;
  skos:definition "A policy that guides FAIR data implementation for a community." .

fip:Data-Steward-Professional-Profile a owl:Class;
  rdfs:label "FAIR data steward professional profile"@en;
  rdfs:subClassOf fip:FAIR-Supporting-Resource;
  skos:definition "A document stating the accumulated training qualifications and FAIR outputs authored by or contributed to, by that person. The profile may be augmented with additional statements regarding professional roles and skills."@en .

fip:FAIR-Data-Stewardship-Event a owl:Class;
  rdfs:label "FAIR data stewardship event"@en;
  rdfs:subClassOf fip:FAIR-Supporting-Resource;
  skos:definition "A meeting specifically designed for current or aspiring data stewards to provide a rigorous understanding of the FAIR principles from theory to their concrete implementation."@en .

fip:FAIR-Data-Stewardship-Plan-Template a owl:Class;
  rdfs:label "FAIR data stewardship plan template"@en;
  rdfs:subClassOf fip:FAIR-Supporting-Resource;
  skos:definition "A template guiding data stewardship including how FAIR Principles should be implemented. The template must be completed with project-specific information in any given instance to outline how data are to be handled in preparation for the project,  during the research project, and after the project is completed."@en .

fip:FAIR-Declaration a owl:Class;
  rdfs:label "FAIR Declaration"@en;
  rdfs:subClassOf fip:FAIR-Supporting-Resource;
  skos:definition "The statement of a community on how it addresses a FAIR-related question."@en .

fip:FAIR-Enrichment-Service a owl:Class, owl:Class;
  dct:isPartOf fip:FIP-Ontology, fip:FIP-Ontology;
  rdfs:label "FAIR Enrichment Service", "FAIR Enrichment Service";
  rdfs:subClassOf fip:FAIR-Supporting-Resource, fip:FAIR-Supporting-Technology, fip:FAIR-Supporting-Resource,
    fip:FAIR-Supporting-Technology;
  skos:definition "An online resource that enhances the FAIRness of existing resources through AI software or other techniques with suggested semantic metadata and mappings.",
    "An online resource that enhances the FAIRness of existing resources through AI software or other techniques with suggested semantic metadata and mappings.";
  fip:supports fair:R1.3 .

fip:FAIR-Implementation-Community a owl:Class;
  rdfs:label "FAIR Implementation Community"@en;
  rdfs:subClassOf fip:FAIR-Supporting-Resource;
  skos:definition "A FAIR Implementation Community (FIC) is a self-identified collection of people and/or organizations with the aim to implement the FAIR Principles"@en .

fip:FAIR-Implementation-Profile a owl:Class;
  rdfs:label "FAIR Implementation Profile"@en;
  rdfs:subClassOf fip:FAIR-Enabling-Resource, fip:FAIR-Specification;
  skos:definition "A FAIR Implementation Profile (FIP) is a list of declared technology choices intended to implement each of the FAIR Guiding Principles, made as a collective decision by the members of a particular community of practice."@en;
  fip:enables fair:R1.3 .

fip:FAIR-Interpretation a owl:Class;
  rdfs:label "FAIR interpretation"@en;
  rdfs:subClassOf fip:FAIR-Declaration;
  skos:definition "A theoretical and practical explanation of the FAIR Principle by a recognized expert authority."@en .

fip:FAIR-Orchestration a owl:Class;
  dct:isPartOf fip:FIP-Ontology;
  rdfs:label "FAIR Orchestration";
  skos:definition "A process that operationalizes FAIR Digital Objects by coordinating and deploying infrastructure components (such as FAIR Data Points or Data Visiting Services) across disstributed networks, enabling machine-driven operations, analytics, or queries." .

fip:FAIR-Practice a owl:Class, owl:Class, owl:Class;
  rdfs:label "FAIR Practice", "FAIR practice", "FAIR practice";
  rdfs:subClassOf fip:FAIR-Data-Policy, fip:FAIR-Supporting-Resource, fip:FAIR-Data-Policy,
    fip:FAIR-Supporting-Resource, fip:FAIR-Data-Policy, fip:FAIR-Supporting-Resource;
  skos:definition "A convention for implementing FAIR clarifying the use of resources for a specific goal as defined by a community of practice.",
    "A convention for implementing FAIR clarifying the use of resources for a specific goal as defined by a community of practice.",
    "A convention for implementing FAIR clarifying the use of resources for a specific goal as defined by a community of practice.";
  fip:supports fair:R1.3, fair:R1.3 .

fip:FAIR-Publishing-Service a owl:Class, owl:Class;
  dct:isPartOf fip:FIP-Ontology, fip:FIP-Ontology;
  rdfs:label "FAIR Publishing Service", "FAIR Publishing Service";
  rdfs:subClassOf fip:FAIR-Supporting-Resource, fip:FAIR-Supporting-Technology, fip:FAIR-Supporting-Resource,
    fip:FAIR-Supporting-Technology;
  skos:definition "An online, accessible software system, component, or platform that automates the process of making digital objects publicly discoverable, persistently identifiable, and machine-actionable according to community-specific open standards.",
    "An online, accessible software system, component, or platform that automates the process of making digital objects publicly discoverable, persistently identifiable, and machine-actionable according to community-specific open standards.";
  fip:supports fair:F4 .

fip:FAIR-Qualification-Criteria a owl:Class;
  rdfs:label "FAIR Qualifcation Criteria"@en;
  rdfs:subClassOf fip:FAIR-Declaration;
  skos:definition "A proposition on which a qualification of FAIR Supporting Resources is based."@en .

fip:FAIR-Representation-Service a owl:Class;
  rdfs:label "FAIR Representation Service"@en;
  rdfs:subClassOf fip:FAIR-Supporting-Technology;
  skos:definition "A transformation service that converts non-FAIR data into a FAIR representation using machine-readable knowledge representation languages."@en;
  fip:supports fair:I1 .

fip:FAIR-Specification a owl:Class, owl:Class;
  rdfs:label "FAIR Specification", "FAIR specification"@en;
  rdfs:subClassOf fip:FAIR-Supporting-Resource, fip:FAIR-Supporting-Resource;
  skos:definition "A precise description of features, requirements, constraints and recommendations for a specific implementation of a component, system or service supporting the implementation of the FAIR principles.",
    "A precise description of features, requirements, constraints and recommendations for a specific implementation of a component, system or service supporting the implementation of the FAIR principles."@en .

fip:FAIR-Supporting-Resource a owl:Class, owl:Class;
  rdfs:label "FAIR Supporting Resource", "FAIR Supporting Resource";
  skos:definition "Any resource that supports FAIR implementation. FSRs are represented as FAIR Digital Objects with Globally Unique, Persistent, Resolvable Identifiers (GUPRI) that resolve to machine-readable metadata about the resource.",
    "Any resource that supports FAIR implementation. FSRs are represented as FAIR Digital Objects (using the nanopublication framework) with Globally Unique, Persistent, Resolvable Identifiers (GUPRI) that resolve to machine-readable metadata about the resource." .

fip:FAIR-Supporting-Resource-to-be-Developed a owl:Class;
  rdfs:label "FAIR Supporting Resource to be developed"@en;
  rdfs:subClassOf fip:FAIR-Supporting-Resource;
  skos:definition "A FAIR Supporting Resource that is not yet available but still needs to be developed."@en .

fip:FAIR-Supporting-Software a owl:Class, owl:DeprecatedClass;
  rdfs:label "FAIR Supporting Software";
  rdfs:subClassOf fip:FAIR-Supporting-Technology;
  skos:definition "Any set of machine-readable instructions that support the implementation of FAIR, that conform to a given syntax, that are interpretable by a given processor, and that instruct a computer's processor to perform specific tasks." .

fip:FAIR-Supporting-Technology a owl:Class;
  rdfs:label "FAIR Supporting Technology"@en;
  rdfs:subClassOf fip:FAIR-Supporting-Resource;
  skos:definition "Any online accessible software system or component that supports the implementation of the FAIR Principles."@en .

fip:FAIR-Training-Material a owl:Class;
  rdfs:label "FAIR training material"@en;
  rdfs:subClassOf fip:FAIR-Supporting-Resource;
  skos:definition "Any educational resource (such as the content or its published representation in text, presentation graphics, or video) that covers FAIR topics of interest."@en .

fip:FAIR-Visualization-Service a owl:Class, owl:Class;
  dct:isPartOf fip:FIP-Ontology, fip:FIP-Ontology;
  rdfs:label "FAIR Visualization Service", "FAIR Visualization Service";
  rdfs:subClassOf fip:FAIR-Supporting-Resource, fip:FAIR-Supporting-Technology, fip:FAIR-Supporting-Resource,
    fip:FAIR-Supporting-Technology;
  skos:definition "An online resource that dynamically transforms complex, structured data into interactive, human-interpretable graphical representations (such as maps, charts, dashboards, or 3D renders) by natively consuming or generating FAIR Digital Objects.",
    "An online resource that dynamically transforms complex, structured data into interactive, human-interpretable graphical representations (such as maps, charts, dashboards, or 3D renders) by natively consuming or generating FAIR Digital Objects.";
  fip:supports fair:R1.3 .

fip:FAIR-Enabling-Resource a owl:Class;
  rdfs:label "FAIR-Enabling Resource"@en;
  rdfs:subClassOf fip:FAIR-Supporting-Resource;
  skos:definition "A service, a specification or a data policy that is essential to the operationalization of the FAIR Principles, i.e., puts FAIR into action. A FAIR-Enabling Resource (FER) provides a function needed to achieve some aspect of FAIR behavior and is explicitly linked to one or more FAIR principles."@en .

fip:FAIR-Enabling-Resource-to-be-Developed a owl:Class;
  rdfs:label "FAIR-Enabling Resource to be Developed"@en;
  rdfs:subClassOf fip:FAIR-Enabling-Resource, fip:FAIR-Supporting-Resource-to-be-Developed;
  skos:definition "A FAIR-enabling resource that is not yet available but still needs to be developed"@en .

fip:FAIRification a owl:Class;
  dct:isPartOf fip:FIP-Ontology;
  rdfs:label "FAIRification";
  skos:definition "A process that transforms non-FAIR or partially FAIR resources into standardized, machine-actionable digital resources (called FAIR Digital Objects) by assigning global, unique and persistent identifiers and associating explicit metadata based on FAIR Supporting Resources as defined in a FAIR Implementation Profile (FIP)." .

fip:FAIRification-Workflow a owl:Class, owl:Class;
  dct:isPartOf fip:FIP-Ontology, fip:FIP-Ontology;
  rdfs:label "FAIRification Workflow", "FAIRification Workflow";
  rdfs:subClassOf fip:FAIR-Supporting-Resource, fip:FAIR-Supporting-Technology, fip:FAIR-Supporting-Resource,
    fip:FAIR-Supporting-Technology;
  skos:definition "An exectuable, structured, and repeatable sequence of automated and human steps designed to transform non-FAIR digital objects into fully FAIR Digital Objects using a list of FAIR Supporting Resources.",
    "An exectuable, structured, and repeatable sequence of automated and human steps designed to transform non-FAIR digital objects into fully FAIR Digital Objects using a list of FAIR Supporting Resources.";
  fip:supports fair:R1.3 .

fip:FIP-Data-related-Question a owl:Class;
  rdfs:label "FIP Data-related Question";
  rdfs:subClassOf fip:FIP-Question;
  skos:definition "A FIP question that is relevant for the actual data (as compared to just their metadata)" .

fip:FIP-Declaration a owl:Class;
  rdfs:label "FIP Declaration"@en;
  rdfs:subClassOf fip:FAIR-Declaration;
  skos:definition "The expression of a community on how they address a FIP question"@en .

fip:FIP-Metadata-related-Question a owl:Class;
  rdfs:label "FIP Metadata-related Question"@en;
  rdfs:subClassOf fip:FIP-Question;
  skos:definition "A FIP question that is relevant for metadata (as compared to the data themselves)"@en .

fip:FIP-No-Choice-Declaration a owl:Class;
  rdfs:label "FIP No-Choice Declaration"@en;
  rdfs:subClassOf fip:FIP-Declaration;
  skos:definition "A declaration stating that no choice has been made (yet)"@en .

fip:FIP-Question a owl:Class;
  rdfs:label "FIP Question"@en;
  skos:definition "A question communities have to address when declaring their FAIR Implementation Profiles"@en .

fip:FIP-S-Question a owl:Class;
  dct:isPartOf fip:FIP-Ontology;
  rdfs:label "FIP Supporting Question";
  rdfs:subClassOf fip:FIP-Question;
  skos:definition "A question communities can address when declaring their FAIR Implementation Profiles" .

fip:FSR-Declaration a owl:Class;
  rdfs:label "FSR Declaration"@en;
  rdfs:subClassOf fip:FAIR-Declaration;
  skos:definition "The statement of a community on the usage of a FAIR Supporting Resource."@en .

fip:Generalist-Registry a owl:Class, owl:Class;
  rdfs:label "Generalist Registry", "Generalist registry"@en;
  rdfs:subClassOf fip:Registry, fip:Registry;
  skos:definition "A registry designed to collect, provide access to, and enable searching of data without any restrictions on the domain.",
    "A registry designed to collect, provide access to, and enable searching of data without any restrictions on the domain."@en .

fip:Identifier-service a owl:Class, owl:Class;
  rdfs:label "Identifier Service", "Identifier service"@en;
  rdfs:subClassOf fip:FAIR-Enabling-Resource, fip:FAIR-Supporting-Technology, fip:FAIR-Enabling-Resource,
    fip:FAIR-Supporting-Technology;
  skos:definition "A service that provides for any digital object (1) algorithms guaranteeing global uniqueness, (2) policy document that guarantees persistent and (3) resolution of the identifier to machine-actionable metadata describing the object and its location.",
    "A service that provides for any digital object (1) algorithms guaranteeing global uniqueness, (2) policy document that guarantees persistent and (3) resolution of the identifier to machine-actionable metadata describing the object and its location."@en;
  fip:enables fair:F1, fair:F1 .

fip:Integration-Service a owl:Class, owl:Class;
  dct:isPartOf fip:FIP-Ontology, fip:FIP-Ontology;
  rdfs:label "Integration Service", "Integration Service";
  rdfs:subClassOf fip:FAIR-Supporting-Resource, fip:FAIR-Supporting-Technology, fip:FAIR-Supporting-Resource,
    fip:FAIR-Supporting-Technology;
  skos:definition "A software interface (e.g., Web-API) that provides a structured, secure, and reliable gateway to connect different systems, allowing users or machines to retrieve, query, consolidate, or interact with data and resources across multiple sources.",
    "A software interface (e.g., Web-API) that provides a structured, secure, and reliable gateway to connect different systems, allowing users or machines to retrieve, query, consolidate, or interact with data and resources across multiple sources.";
  fip:supports fair:A1.1 .

fip:Knowledge-representation-language a owl:Class, owl:Class;
  rdfs:label "Knowledge Representation Language", "Knowledge representation language"@en;
  rdfs:subClassOf fip:FAIR-Enabling-Resource, fip:FAIR-Specification, fip:FAIR-Enabling-Resource,
    fip:FAIR-Specification;
  skos:definition "A language specification that enables knowledge to be processed by machines.",
    "A language specification that enables knowledge to be processed by machines."@en;
  fip:enables fair:I1, fair:I1 .

fip:Mature-Community a owl:Class;
  rdfs:label "Mature community"@en;
  rdfs:subClassOf fip:FAIR-Implementation-Community;
  skos:definition "A well-established community interested to implement FAIR in their data and services."@en .

fip:Metadata-preservation-policy a owl:Class, owl:Class;
  rdfs:label "Metadata Preservation Policy", "Metadata preservation policy"@en;
  rdfs:subClassOf fip:FAIR-Data-Policy, fip:FAIR-Enabling-Resource, fip:FAIR-Data-Policy,
    fip:FAIR-Enabling-Resource;
  skos:definition "A data policy that describes the conditions under which metadata should be provided in the future.",
    "A data policy that describes the conditions under which metadata should be provided in the future."@en;
  fip:enables fair:A2, fair:A2 .

fip:Metadata-schema a owl:Class, owl:Class;
  rdfs:label "Metadata Schema", "Metadata schema"@en;
  rdfs:subClassOf fip:FAIR-Enabling-Resource, fip:FAIR-Specification, fip:FAIR-Enabling-Resource,
    fip:FAIR-Specification;
  skos:definition "A specification that specifies the structured representation of metadata describing attributes of data or other digital objects in terms of semantics, syntax and optionality.",
    "A specification that specifies the structured representation of metadata describing attributes of data or other digital objects in terms of semantics, syntax and optionality."@en;
  fip:enables fair:F2, fair:F2 .

fip:Metadata-data-linking-schema a owl:Class, owl:Class;
  rdfs:label "Metadata-data Linking Schema", "Metadata-data linking schema"@en;
  rdfs:subClassOf fip:FAIR-Enabling-Resource, fip:FAIR-Specification, fip:FAIR-Enabling-Resource,
    fip:FAIR-Specification;
  skos:definition "A specification that provides a unique, persistent, (ideally) bi-directional, machine-actionable link between metadata and the data they describe.",
    "A specification that provides a unique, persistent, (ideally) bi-directional, machine-actionable link between metadata and the data they describe."@en;
  fip:enables fair:F3, fair:F3 .

fip:Open-Digital-Rights-Language-Specification a owl:Class, owl:Class;
  dct:isPartOf fip:FIP-Ontology, fip:FIP-Ontology;
  rdfs:label "Open Digital Rights Language Specification", "Open Digital Rights Language Specification";
  rdfs:subClassOf fip:FAIR-Specification, fip:FAIR-Supporting-Resource, fip:FAIR-Specification,
    fip:FAIR-Supporting-Resource;
  skos:definition "An Open Digital Rights Language (ODRL) specification is a machine-readable expression of permissions, prohibitions, and obligations that governs how a digital asset (such as a dataset, software, or service) can be used.",
    "An Open Digital Rights Language (ODRL) specification is a machine-readable expression of permissions, prohibitions, and obligations that governs how a digital asset (such as a dataset, software, or service) can be used.";
  fip:supports fair:R1.1 .

fip:Persistency-Policy a owl:Class;
  rdfs:label "Persistency Policy"@en;
  rdfs:subClassOf fip:FAIR-Data-Policy, fip:FAIR-Enabling-Resource;
  skos:definition "A policy with respect to persistency of resources."@en;
  fip:enables fair:A2, fair:F1, fair:F4 .

fip:Provenance-model a owl:Class, owl:Class;
  rdfs:label "Provenance Model", "Provenance model"@en;
  rdfs:subClassOf fip:FAIR-Enabling-Resource, fip:FAIR-Specification, fip:FAIR-Enabling-Resource,
    fip:FAIR-Specification;
  skos:definition "A specification that specifies metadata describing the origin and lineage of data or other digital objects.",
    "A specification that specifies metadata describing the origin and lineage of data or other digital objects."@en;
  fip:enables fair:R1.2, fair:R1.2 .

fip:Provenance-Tracking-Service a owl:Class, owl:Class;
  rdfs:label "Provenance Tracking Service", "Provenance tracking service"@en;
  rdfs:subClassOf fip:FAIR-Supporting-Technology, fip:FAIR-Supporting-Technology;
  skos:definition "A system that systematically captures, stores and manages detailed information about the origin, history, and lifecycle of digital objects creating metadata based on a provenance model.",
    "A system that systematically captures, stores and manages detailed information about the origin, history, and lifecycle of digital objects creating metadata based on a provenance model. "@en;
  fip:supports fair:R1.2, fair:R1.2 .

fip:Reference-FAIR-Implementation-Profile a owl:Class;
  rdfs:label "Reference FAIR Implementation Profile"@en;
  rdfs:subClassOf fip:FAIR-Implementation-Profile;
  skos:definition "A list of recommended FAIR Enabling Resources intended to implement the FAIR Guiding Principles, made as a collective decision by the members of a particular community of practice."@en .

fip:Registry a owl:Class;
  rdfs:label "Registry"@en;
  rdfs:subClassOf fip:FAIR-Enabling-Resource, fip:FAIR-Supporting-Technology;
  skos:definition "A service that indexes metadata and data and provides search over that index."@en;
  fip:enables fair:F4 .

fip:Semantic-Interoperability-Profile a owl:Class, owl:DeprecatedClass;
  rdfs:label "Semantic Interoperability Profile";
  rdfs:subClassOf fip:FAIR-Supporting-Resource;
  skos:definition "A Semantic Interoperability Profil (SIP) is a list of FAIR Supporting Resources chosen by a community to support semantic interoperability of (meta)data." .

fip:Semantic-model a owl:Class, owl:Class;
  rdfs:label "Semantic Model", "Semantic model"@en;
  rdfs:subClassOf fip:FAIR-Enabling-Resource, fip:FAIR-Specification, fip:FAIR-Enabling-Resource,
    fip:FAIR-Specification;
  skos:definition "A specification that defines qualified relations between entities describing data or other digital objects according to the Linked Data principles. This can include semantic data models and ontologies.",
    "A specification that defines qualified relations between entities describing data or other digital objects according to the Linked Data principles. This can include semantic data models and ontologies."@en;
  fip:enables fair:I3, fair:I3 .

fip:SIP-Declaration a owl:Class;
  rdfs:label "SIP Declaration"@en;
  rdfs:subClassOf fip:FAIR-Declaration;
  skos:definition "The statement of a community on how it addresses a SIP question."@en .

fip:Structured-vocabulary a owl:Class, owl:Class;
  rdfs:label "Structured Vocabulary", "Structured vocabulary"@en;
  rdfs:subClassOf fip:FAIR-Enabling-Resource, fip:FAIR-Specification, fip:FAIR-Enabling-Resource,
    fip:FAIR-Specification;
  skos:definition "A specification for a controlled list of uniquely identified and unambigous concepts with their definitions represented using web standards.",
    "A specification for a controlled list of uniquely identified and unambigous concepts with their definitions represented using web standards."@en;
  fip:enables fair:I2, fair:I2 .

fip:Validation-Service a owl:Class, owl:Class;
  rdfs:label "Validation Service", "Validation service"@en;
  rdfs:subClassOf fip:FAIR-Supporting-Technology, fip:FAIR-Supporting-Technology;
  skos:definition "A system that automatically verifies the accuracy, completeness, or compliance of data, code or processes against predefined criteria or standards.",
    "A system that automatically verifies the accuracy, completeness, or compliance of data, code or processes against predefined criteria or standards."@en;
  fip:supports fair:F2, fair:I2, fair:I3, fair:F2, fair:I2, fair:I3 .

fip:Web-API a owl:Class, owl:DeprecatedClass;
  rdfs:label "Web-API";
  rdfs:subClassOf fip:FAIR-Supporting-Technology;
  skos:definition "An Application Programming Interface (API) for the World Wide Web that allows different software applications to communicate with each other." .

fip:availability-in-years a rdf:Property, owl:DatatypeProperty;
  rdfs:domain fip:fip:FAIR-Data-Policy;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/availability-in-years>;
  rdfs:label "availability in years"@en;
  skos:definition "Specifies how many years a resource is preserved according to a preservation policy"@en .

fip:considerations a rdf:Property, owl:DatatypeProperty;
  rdfs:domain fip:FAIR-Declaration;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/considerations>;
  rdfs:label "considerations"@en;
  skos:definition "Considerations that led to a given FIP declaration"@en .

fip:declared-by a rdf:Property, owl:ObjectProperty;
  rdfs:domain fip:FAIR-Declaration;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/declared-by>;
  rdfs:label "declared by"@en;
  rdfs:range fip:FAIR-Implementation-Community;
  skos:definition "Connects a FIP declaration to the community that made the declaration"@en .

fip:declared-for-case-study a rdf:Property, owl:ObjectProperty;
  rdfs:domain fip:FAIR-Declaration;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/declared-for-case-study>;
  rdfs:label "declared for case study"@en;
  rdfs:range fip:FAIR-Case-Study;
  skos:definition "Connects a FIP declaration to the case study it refers to."@en .

fip:declared-for-digital-object-type a rdf:Property, owl:ObjectProperty;
  rdfs:domain fip:FAIR-Declaration;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/declared-for-digital-object-type>;
  rdfs:label "declared for digital object type"@en;
  rdfs:range fip:Digital-Object-Type;
  skos:definition "Connects a FIP declaration to the digital object type it applies to"@en .

fip:declares-current-use-of a rdf:Property, owl:ObjectProperty;
  rdfs:domain fip:FAIR-Declaration;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/declares-current-use-of>;
  rdfs:label "declares current use of"@en;
  rdfs:range fip:Available-FAIR-Supporting-Resource;
  skos:definition "Connects a FIP declaration to the resource that the community thereby declares to currently use"@en .

fip:declares-planned-development-of a rdf:Property, owl:ObjectProperty;
  rdfs:domain fip:FAIR-Declaration;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/declares-planned-development-of>;
  rdfs:label "declares planned development of"@en;
  rdfs:range fip:FAIR-Supporting-Resource-to-be-Developed;
  skos:definition "Connects a FIP declaration to the resource that the community thereby declares to plan to develop"@en .

fip:declares-planned-replacement-of a rdf:Property, owl:ObjectProperty;
  rdfs:domain fip:FAIR-Declaration;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/declares-planned-replacement-of>;
  rdfs:label "declares planned replacement of"@en;
  rdfs:range fip:Available-FAIR-Supporting-Resource;
  skos:definition "Connects a FIP declaration to the resource that the community thereby declares to plan to replace in the future. The same declaration should also state a resource that the community declares to plan to use instead (with fip:declares-planned-use-of)."@en .

fip:declares-planned-use-of a rdf:Property, owl:ObjectProperty;
  rdfs:domain fip:FAIR-Declaration;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/declares-planned-use-of>;
  rdfs:label "declares planned use of"@en;
  rdfs:range fip:FAIR-Supporting-Resource;
  skos:definition "Connects a FIP declaration to the resource that the community thereby declares to plan to use in the future"@en .

fip:depends-on a rdf:Property, owl:ObjectProperty;
  rdfs:domain fip:FAIR-Enabling-Resource;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/depends-on>;
  rdfs:label "depends on"@en;
  rdfs:range fip:FAIR-Supporting-Software;
  skos:definition "Connects a FAIR Enabling Resource with a FAIR Supporting Software."@en .

fip:enables a rdf:Property, owl:ObjectProperty;
  rdfs:domain owl:Class;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/enables>;
  rdfs:label "enables"@en;
  rdfs:range fair:FAIR-Principle-or-SubPrinciple;
  skos:definition "Connects a FAIR Enabling Resource class with the FAIR principles it enables"@en .

fip:has-data-steward a rdf:Property, owl:ObjectProperty;
  rdfs:domain fip:FAIR-Implementation-Community;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/has-data-steward>;
  rdfs:label "has data steward"@en;
  rdfs:subPropertyOf foaf:member;
  skos:definition "Specifies the data steward for a FAIR implementation community"@en .

fip:has-data-usage-license a rdf:Property, owl:ObjectProperty;
  rdfs:domain fip:FAIR-Enabling-Resource;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/has-data-usage-license>;
  rdfs:label "has data usage license"@en;
  rdfs:range fip:Data-usage-license;
  skos:definition "Connects a FAIR Enabling Resource with a data usage license."@en .

fip:has-declaration-index a rdf:Property, owl:ObjectProperty;
  rdfs:domain fip:FAIR-Supporting-Resource;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/has-declaration-index>;
  rdfs:label "has declaration index"@en;
  rdfs:range npx:NanopubIndex;
  skos:definition "Connects a FAIR Implementation Profile or a Semantic Interoperability Profile to the index of their declarations."@en .

fip:has-description-source a rdf:Property, owl:ObjectProperty;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/has-description-source>;
  rdfs:label "has description source"@en;
  skos:definition "Denotes the source of the description that is asserted via dct:description"@en .

fip:has-MPP a rdf:Property, owl:ObjectProperty;
  rdfs:domain fip:Registry;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/has-MPP>;
  rdfs:label "has metadata preservation policy"@en;
  rdfs:range fip:Metadata-preservation-policy;
  skos:definition "Connects a registry with a metadata preservation policy."@en .

fip:has-persistency-policy a rdf:Property, owl:ObjectProperty;
  rdfs:domain fip:FAIR-Supporting-Resource;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/has-persistency-policy>;
  rdfs:label "has persistency policy"@en;
  rdfs:range fip:Persistency-Policy;
  skos:definition "Connects a FAIR Supporting Resource with a persistency policy"@en .

fip:has-research-domain a rdf:Property, owl:ObjectProperty;
  rdfs:domain fip:FAIR-Implementation-Community;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/has-research-domain>;
  rdfs:label "has research domain"@en;
  skos:definition "Connects a FAIR Implementation Community with research domains"@en .

fip:implements a rdf:Property, owl:ObjectProperty;
  rdfs:domain fip:FAIR-Enabling-Resource;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/implements>;
  rdfs:label "implements"@en;
  rdfs:range fip:FAIR-Specification;
  skos:definition "Connects a FAIR Enabling Resource with a FAIR Specification"@en .

fip:recommended-by a rdf:Property, owl:ObjectProperty;
  rdfs:domain fip:FAIR-Supporting-Resource;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/recommended-by>;
  rdfs:label "is recommended by"@en;
  rdfs:range fip:FAIR-Implementation-Community;
  skos:definition "Connects a FAIR Supporting Resource with a FAIR Implementation Community that recommends the resource"@en .

fip:metadata-availability-in-years a rdf:Property, owl:DatatypeProperty;
  rdfs:domain fip:Metadata-preservation-policy;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/metadata-availability-in-years>;
  rdfs:label "metadata availability in years"@en;
  rdfs:subPropertyOf fip:availability-in-years;
  skos:definition "Specifies how many years metadata are preserved according to the metadata preservation policy"@en .

fip:refers-to-principle a rdf:Property, owl:ObjectProperty;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/refers-to-principle>;
  rdfs:label "refers to principle"@en;
  rdfs:range fair:FAIR-Principle-or-SubPrinciple;
  skos:definition "Connects an entity (for example a FIP declaration) to a FAIR (sub)principle it refers to"@en .

fip:refers-to-question a rdf:Property, owl:ObjectProperty;
  rdfs:domain fip:FIP-Declaration;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/refers-to-question>;
  rdfs:label "refers to question"@en;
  rdfs:range fip:FIP-Question;
  skos:definition "Connects a FIP declaration to the FIP question it is addressing"@en .

fip:targets a rdf:Property, owl:ObjectProperty;
  rdfs:domain fip:FAIR-Supporting-Resource;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/targets>;
  rdfs:label "targets"@en;
  rdfs:range fip:Digital-Object-Type;
  skos:definition "Specifies the type of digital object targeted by a FAIR Supporting Resources"@en .

fip:has-AAS a rdf:Property, owl:ObjectProperty;
  rdfs:domain fip:Registry;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/has-AAS>;
  rdfs:label "uses authentication and authorization service"@en;
  rdfs:range fip:Authentication-and-authorization-service;
  skos:definition "Connects a registry with an authentication and authorization service"@en .

fip:uses-identifier-service a rdf:Property, owl:ObjectProperty;
  rdfs:domain fip:Registry;
  rdfs:isDefinedBy <https://w3id.org/fair/fip/latest/uses-identifier-service>;
  rdfs:label "uses identifier service"@en;
  rdfs:range fip:Identifier-service;
  skos:definition "Connects a registry with an identifier service."@en .

fip:supports a rdf:Property, owl:ObjectProperty;
  dct:isPartOf fip:FIP-Ontology;
  rdfs:domain fip:FAIR-Supporting-Resource;
  rdfs:label "supports";
  skos:definition "Connects a FAIR Supporting Resource with the FAIR principles or FAIR processes it facilitates or operationalizes." .

fip:FIP-Question-A1.1-D a owl:NamedIndividual, fip:FIP-Question;
  rdfs:label "FIP Question A1.1-D"@en;
  skos:definition "Which standardized communication protocol do you use for datasets?"@en;
  fip:refers-to-principle fair:A1.1 .

fip:FIP-Question-A1.1-MD a owl:NamedIndividual, fip:FIP-Question;
  rdfs:label "FIP Question A1.1-MD"@en;
  skos:definition "Which standardized communication protocol do you use for metadata records?"@en;
  fip:refers-to-principle fair:A1.1 .

fip:FIP-Question-A1.2-D a owl:NamedIndividual, fip:FIP-Question;
