fip:FIP-Question-I1-MD a owl:NamedIndividual, fip:FIP-Question;
  rdfs:label "FIP Question I1-MD"@en;
  skos:definition "Which knowledge representation languages (allowing machine interoperation) do you use for metadata records?"@en;
  fip:refers-to-principle fair:I1 .

fip:FIP-Question-I2-D a owl:NamedIndividual, fip:FIP-Question;
