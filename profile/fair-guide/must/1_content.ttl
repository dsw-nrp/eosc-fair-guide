@prefix fg: <https://fair.eosc.cz/terms#> .
@prefix fair-guide: <https://fair.eosc.cz/profile/fair-guide/> .
@prefix ftr: <https://w3id.org/ftr#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# The conceptual model is independent of FAIR principles, reader lenses and source-issued requirements. Its layers and
# seams are the model's terms, and its examples are parts of them; each shape selects them by that, never by the property
# it requires, so an item that loses its kind, its transfer or its scope still fails.

fair-guide:ImplementationModelItem a sh:NodeShape ;
    sh:name "Implementation model item" ;
    sh:description "Layers, seams and examples have their kind, bilingual descriptions and their source" ;
    sh:target [ a sh:SPARQLTarget ; sh:select """
        SELECT ?this WHERE { { ?this <http://schema.org/inDefinedTermSet> <https://fair.eosc.cz/id/models/layers-seams> } UNION { ?this <http://schema.org/isPartOf> ?term . ?term <http://schema.org/inDefinedTermSet> <https://fair.eosc.cz/id/models/layers-seams> } }
    """ ] ;
    sh:property [ sh:path fg:modelKind ; sh:class schema:DefinedTerm ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path ( fg:modelKind schema:termCode ) ; sh:in ( "layer" "seam" "example" ) ] ;
    sh:property [ sh:path schema:identifier ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path schema:name ; sh:languageIn ( "cs" "en" ) ; sh:uniqueLang true ; sh:minCount 2 ] ;
    sh:property [ sh:path schema:description ; sh:languageIn ( "cs" "en" ) ; sh:uniqueLang true ; sh:minCount 2 ] ;
    sh:or (
        [ sh:property [ sh:path dcterms:source ; sh:minCount 1 ] ]
        [ sh:property [ sh:path schema:citation ; sh:minCount 1 ] ]
    ) ;
    sh:or (
        [ sh:property [ sh:path ( fg:modelKind schema:termCode ) ; sh:hasValue "example" ] ]
        [ sh:property [ sh:path fg:serviceStatus ; sh:maxCount 0 ] ;
          sh:property [ sh:path fg:statusAsOf ; sh:maxCount 0 ] ]
    ) .

fair-guide:ImplementationSeam a sh:NodeShape ;
    sh:name "Implementation seam" ;
    sh:description "A seam names the transferred information, actors, carrier and maintaining actors" ;
    sh:target [ a sh:SPARQLTarget ; sh:select """
        SELECT ?this WHERE { ?this <https://fair.eosc.cz/terms#modelKind> <https://fair.eosc.cz/id/vocabularies/model-kinds/seam> }
    """ ] ;
    sh:class schema:DefinedTerm ;
    sh:property [ sh:path schema:inDefinedTermSet ; sh:class schema:DefinedTermSet ; sh:minCount 1 ] ;
    sh:property [ sh:path fg:implementationLayers ; sh:class schema:DefinedTerm ; sh:minCount 1 ] ;
    sh:property [ sh:path fg:transfer ; sh:languageIn ( "cs" "en" ) ; sh:uniqueLang true ; sh:minCount 2 ] ;
    sh:property [ sh:path fg:sender ; sh:languageIn ( "cs" "en" ) ; sh:uniqueLang true ; sh:minCount 2 ] ;
    sh:property [ sh:path fg:recipient ; sh:languageIn ( "cs" "en" ) ; sh:uniqueLang true ; sh:minCount 2 ] ;
    sh:property [ sh:path fg:carrier ; sh:languageIn ( "cs" "en" ) ; sh:uniqueLang true ; sh:minCount 2 ] ;
    sh:property [ sh:path fg:maintainers ; sh:languageIn ( "cs" "en" ) ; sh:uniqueLang true ; sh:minCount 2 ] .

fair-guide:ImplementationExample a sh:NodeShape ;
    sh:name "Scoped implementation example" ;
    sh:description "Only a precise, evidenced example carries an observed implementation status" ;
    sh:target [ a sh:SPARQLTarget ; sh:select """
        SELECT ?this WHERE { ?this <https://fair.eosc.cz/terms#modelKind> <https://fair.eosc.cz/id/vocabularies/model-kinds/example> }
    """ ] ;
    sh:class schema:CreativeWork ;
    sh:property [ sh:path ( fg:modelKind schema:termCode ) ; sh:hasValue "example" ] ;
    sh:property [ sh:path schema:isPartOf ; sh:class schema:DefinedTerm ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path fg:scope ; sh:languageIn ( "cs" "en" ) ; sh:uniqueLang true ; sh:minCount 2 ] ;
    sh:property [ sh:path fg:serviceStatus ; sh:class schema:DefinedTerm ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path fg:statusAsOf ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$" ] .

fair-guide:ApprovedModelManuscript a sh:NodeShape ;
    sh:name "Approved model manuscript" ;
    sh:description "The in-preparation exception is restricted to one conceptual source, with no publication claims" ;
    sh:targetNode <https://fair.eosc.cz/id/resources/layers-seams-manuscript> ;
    sh:class schema:ScholarlyArticle ;
    sh:property [ sh:path schema:identifier ; sh:hasValue "layers-seams-manuscript" ] ;
    sh:property [ sh:path fg:preparationStatus ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path schema:termCode ; sh:hasValue "in-preparation" ] ] ] ;
    sh:property [ sh:path schema:datePublished ; sh:maxCount 0 ] ;
    sh:property [ sh:path schema:publisher ; sh:maxCount 0 ] ;
    sh:property [ sh:path schema:license ; sh:maxCount 0 ] .

# Bilingual text: one Czech and one English value.

fair-guide:Station a sh:NodeShape ;
    sh:name "Station" ;
    sh:description "A station has a Czech and an English name, a position on the path and advice items" ;
    sh:targetClass schema:HowToSection ;
    sh:property [
        sh:name "Station name in Czech" ;
        sh:path schema:name ;
        sh:qualifiedValueShape [ sh:languageIn ( "cs" ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A station MUST have a Czech name" ;
    ] ;
    sh:property [
        sh:name "Station name in English" ;
        sh:path schema:name ;
        sh:qualifiedValueShape [ sh:languageIn ( "en" ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A station MUST have an English name" ;
    ] ;
    sh:property [
        sh:name "Station position" ;
        sh:path schema:position ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A station MUST have exactly one position on the path" ;
    ] ;
    sh:property [
        sh:name "Station advice" ;
        sh:path schema:itemListElement ;
        sh:minCount 1 ;
        sh:message "A station MUST contain at least one advice item" ;
    ] .

fair-guide:AdviceItem a sh:NodeShape ;
    sh:name "Advice item" ;
    sh:description "An advice item has Czech and English text, a lens, a disclosure level, its kind and at least one cited clause" ;
    sh:targetClass fg:AdviceItem ;
    sh:property [
        sh:name "Advice level" ;
        sh:path fg:disclosureLevel ;
        sh:class schema:DefinedTerm ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An advice item MUST have exactly one disclosure level" ;
    ] ;
    sh:property [
        sh:name "Advice kind" ;
        sh:path fg:adviceKind ;
        sh:class schema:DefinedTerm ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An advice item MUST name its kind: a direction, a tip, a key point or an AI tip" ;
    ] ;
    sh:property [
        sh:name "Advice text in Czech" ;
        sh:path schema:text ;
        sh:qualifiedValueShape [ sh:languageIn ( "cs" ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "An advice item MUST have Czech text" ;
    ] ;
    sh:property [
        sh:name "Advice text in English" ;
        sh:path schema:text ;
        sh:qualifiedValueShape [ sh:languageIn ( "en" ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "An advice item MUST have English text" ;
    ] ;
    sh:property [
        sh:name "Advice lens" ;
        sh:path schema:audience ;
        sh:class schema:Audience ;
        sh:minCount 1 ;
        sh:message "An advice item MUST be addressed to at least one lens" ;
    ] ;
    sh:property [
        sh:name "Advice sources" ;
        sh:path schema:citation ;
        sh:minCount 1 ;
        sh:message "An advice item MUST cite at least one clause of the ledger" ;
    ] ;
    sh:property [
        sh:name "Advice station" ;
        sh:path schema:isPartOf ;
        sh:class schema:HowToSection ;
        sh:minCount 1 ;
        sh:message "An advice item MUST belong to a station" ;
    ] .

fair-guide:Clause a sh:NodeShape ;
    sh:name "Ledger clause" ;
    sh:description "A clause has an identifier, its kind, Czech and English text and a published source" ;
    sh:targetClass fg:Clause ;
    sh:property [
        sh:name "Clause kind" ;
        sh:path fg:clauseKind ;
        sh:class schema:DefinedTerm ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A clause MUST have exactly one kind" ;
    ] ;
    sh:property [
        sh:name "Clause identifier" ;
        sh:path schema:identifier ;
        sh:minCount 1 ;
        sh:message "A clause MUST have an identifier" ;
    ] ;
    sh:property [
        sh:name "Clause text in Czech" ;
        sh:path schema:text ;
        sh:qualifiedValueShape [ sh:languageIn ( "cs" ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A clause MUST have Czech text" ;
    ] ;
    sh:property [
        sh:name "Clause text in English" ;
        sh:path schema:text ;
        sh:qualifiedValueShape [ sh:languageIn ( "en" ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A clause MUST have English text" ;
    ] ;
    sh:property [
        sh:name "Clause source" ;
        sh:path schema:isPartOf ;
        sh:minCount 1 ;
        sh:message "A clause MUST name the published source it comes from" ;
    ] .

fair-guide:CheckItem a sh:NodeShape ;
    sh:name "Self-check item" ;
    sh:description "A self-check item has Czech and English statements, a tier, at least one cited clause and a check" ;
    sh:targetClass schema:Question ;
    sh:property [
        sh:name "Statement in Czech" ;
        sh:path schema:text ;
        sh:qualifiedValueShape [ sh:languageIn ( "cs" ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A self-check item MUST have a Czech statement" ;
    ] ;
    sh:property [
        sh:name "Statement in English" ;
        sh:path schema:text ;
        sh:qualifiedValueShape [ sh:languageIn ( "en" ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A self-check item MUST have an English statement" ;
    ] ;
    sh:property [
        sh:name "Item tier" ;
        sh:path fg:tier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A self-check item MUST have exactly one tier" ;
    ] ;
    sh:property [
        sh:name "Item sources" ;
        sh:path schema:citation ;
        sh:minCount 1 ;
        sh:message "A self-check item MUST cite at least one clause of the ledger" ;
    ] ;
    sh:property [
        sh:name "Item check" ;
        sh:path ftr:hasBenchmark ;
        sh:class schema:Quiz ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A self-check item MUST belong to a check, its FTR benchmark" ;
    ] .

fair-guide:Resource a sh:NodeShape ;
    sh:name "Resource" ;
    sh:description "A resource has a name and the Guide's type: its own, or the one its citation form or registry gives" ;
    sh:targetClass fg:Resource ;
    sh:property [
        sh:name "Resource name" ;
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:message "A resource MUST have a name" ;
    ] ;
    sh:or (
        [ sh:property [ sh:path fg:resourceType ; sh:class schema:DefinedTerm ; sh:minCount 1 ] ]
        [ sh:property [ sh:path fg:guideType ; sh:class schema:DefinedTerm ; sh:minCount 1 ] ]
    ) ;
    sh:message "A resource MUST have the Guide's type" .

# A resource the Guide types itself is one it recommends: it has an HTTPS link and a dated status.
fair-guide:CuratedResource a sh:NodeShape ;
    sh:name "Curated resource" ;
    sh:description "A resource the Guide types itself has an HTTPS link and a dated status" ;
    sh:targetSubjectsOf fg:resourceType ;
    sh:property [
        sh:name "Resource link" ;
        sh:path schema:url ;
        sh:minCount 1 ;
        sh:pattern "^https://" ;
        sh:message "A resource MUST have an HTTPS link" ;
    ] ;
    sh:or (
        [ sh:property [
            sh:name "Resource status" ;
            sh:path fg:serviceStatus ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:message "A resource MUST have exactly one status"
        ] ]
        [ sh:property [
            sh:name "Node state" ;
            sh:path fg:nodeState ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:message "An EOSC Node MUST have its federation state"
        ] ]
    ) ;
    sh:property [
        sh:name "Resource status date" ;
        sh:path fg:statusAsOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" ;
        sh:message "A resource status MUST carry an as-of date (YYYY-MM-DD)" ;
    ] .

fair-guide:Repository a sh:NodeShape ;
    sh:name "Repository" ;
    sh:description "A repository has its kind and an HTTPS address, or is not yet public with planned/development status and an NKR record" ;
    sh:targetClass fg:Repository ;
    sh:property [
        sh:name "Repository kind" ;
        sh:path fg:repositoryKind ;
        sh:class schema:DefinedTerm ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A repository MUST have exactly one kind" ;
    ] ;
    sh:and (
        [
            sh:or (
                [ sh:property [ sh:path schema:url ; sh:minCount 1 ; sh:pattern "^https://" ] ]
                [
                    sh:property [
                        sh:path fg:serviceStatus ; sh:minCount 1 ; sh:maxCount 1 ;
                        sh:node [ sh:property [ sh:path schema:termCode ; sh:minCount 1 ; sh:in ( "planned" "in-development" ) ] ]
                    ] ;
                    sh:property [
                        sh:path schema:sameAs ;
                        sh:qualifiedValueShape [ sh:pattern "^https://repo[.]cz/objects/.+" ] ;
                        sh:qualifiedMinCount 1
                    ]
                ]
            ) ;
            sh:message "A repository needs an HTTPS address, or planned/development status with an NKR record"
        ]
        [
            sh:or (
                [ sh:property [ sh:path schema:isBasedOn ; sh:minCount 1 ] ]
                [ sh:property [
                    sh:path [ sh:inversePath foaf:primaryTopic ] ;
                    sh:class dcat:CatalogRecord ;
                    sh:minCount 1
                ] ]
            ) ;
            sh:message "A repository MUST credit the Guide's selection or a registry record about it"
        ]
    ) ;
    sh:property [
        sh:name "Repository link" ;
        sh:path schema:url ;
        sh:pattern "^https://" ;
        sh:message "A repository MUST have an HTTPS link" ;
    ] .

fair-guide:ProvenanceAction a sh:NodeShape ;
    sh:name "Provenance action" ;
    sh:description "A provenance action names a person, the instruments, the produced items and an end time" ;
    sh:targetClass schema:CreateAction , schema:UpdateAction ;
    sh:property [
        sh:name "Action agent" ;
        sh:path schema:agent ;
        sh:class schema:Person ;
        sh:minCount 1 ;
        sh:message "A provenance action MUST name the person responsible" ;
    ] ;
    sh:property [
        sh:name "Action result" ;
        sh:path schema:result ;
        sh:minCount 1 ;
        sh:message "A provenance action MUST name the items it produced or changed" ;
    ] ;
    sh:property [
        sh:name "Action end time" ;
        sh:path schema:endTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}(Z|[+-][0-9]{2}:[0-9]{2})$" ;
        sh:message "A provenance action MUST have an end time with a time zone" ;
    ] .
