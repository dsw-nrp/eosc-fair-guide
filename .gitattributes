# Text files are stored and checked out with LF line endings on every platform.
* text=auto eol=lf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary

# Build output is written to the ignored _site/ and never committed (the content checks refuse it), so no
# generated-file attributes are needed; assets/diagrams/ holds the approved figure adaptations, which are authored.
